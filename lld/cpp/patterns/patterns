#include <iostream>
#include <string>
#include <vector>

struct Inventory {
  bool lockSeats(int showId, const std::vector<int>& seats) {
    std::cout << "Locked seats for show " << showId << "\n"; return true;
  }
};
struct Payments {
  bool charge(double amount) { std::cout << "Charged " << amount << "\n"; return true; }
};
struct Tickets {
  std::string issue(int bookingId) { return "TIX-" + std::to_string(bookingId); }
};

struct BookingFacade {
  Inventory inv; Payments pay; Tickets tix;
  bool book(int showId, const std::vector<int>& seats, double amount, int bookingId) {
    if (!inv.lockSeats(showId, seats)) return false;
    if (!pay.charge(amount)) return false;
    std::cout << "Ticket: " << tix.issue(bookingId) << "\n";
    return true;
  }
};
 
 


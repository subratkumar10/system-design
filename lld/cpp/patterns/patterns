#include <iostream>
#include <map>
#include <memory>
#include <string>

struct SeatType {
  std::string name; double basePrice;
  SeatType(std::string n, double p) : name(std::move(n)), basePrice(p) {}
};
struct SeatTypeFactory {
  std::map<std::string, std::shared_ptr<SeatType>> pool;
  std::shared_ptr<SeatType> get(const std::string& key, double price) {
    auto it = pool.find(key);
    if (it != pool.end()) return it->second;
    auto p = std::make_shared<SeatType>(key, price);
    pool[key] = p; return p;
  }
};
struct Seat {
  int row, col; std::shared_ptr<SeatType> type; // shared intrinsic data
  double dynamicAdj; // extrinsic: show-specific adjustment
  double price() const { return type->basePrice + dynamicAdj; }
};
 
 


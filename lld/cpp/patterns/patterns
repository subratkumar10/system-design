#include <functional>
#include <iostream>
#include <vector>

class Notifier {
  std::vector<std::function<void(const std::string&)>> subs_;
public:
  void subscribe(std::function<void(const std::string&)> fn) { subs_.push_back(std::move(fn)); }
  void emit(const std::string& msg) { for (auto& s : subs_) s(msg); }
};


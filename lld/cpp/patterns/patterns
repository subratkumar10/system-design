#include <iostream>
#include <memory>
#include <string>

struct Booking; // fwd

struct BookingState {
  virtual ~BookingState() = default;
  virtual void reserve(Booking&) { std::cout << "Invalid transition\n"; }
  virtual void pay(Booking&)     { std::cout << "Invalid transition\n"; }
  virtual void cancel(Booking&)  { std::cout << "Invalid transition\n"; }
  virtual const char* name() const = 0;
};

struct Booking {
  std::unique_ptr<BookingState> state;
  explicit Booking(std::unique_ptr<BookingState> s) : state(std::move(s)) {}
  void set(std::unique_ptr<BookingState> s) { state = std::move(s); }
  void reserve() { state->reserve(*this); }
  void pay()     { state->pay(*this); }
  void cancel()  { state->cancel(*this); }
  void print()   { std::cout << "State: " << state->name() << "\n"; }
};

struct Selecting : BookingState {
  const char* name() const override { return "Selecting"; }
  void reserve(Booking& b) override;
};
struct Reserved : BookingState {
  const char* name() const override { return "Reserved"; }
  void pay(Booking& b) override;
  void cancel(Booking& b) override;
};
struct Paid : BookingState {
  const char* name() const override { return "Paid"; }
};
struct Cancelled : BookingState {
  const char* name() const override { return "Cancelled"; }
};

void Selecting::reserve(Booking& b) { std::cout << "Seats locked.\n"; b.set(std::make_unique<Reserved>()); }
void Reserved::pay(Booking& b)      { std::cout << "Payment successful.\n"; b.set(std::make_unique<Paid>()); }
void Reserved::cancel(Booking& b)   { std::cout << "Reservation cancelled.\n"; b.set(std::make_unique<Cancelled>()); }
 
 


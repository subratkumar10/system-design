#include <iostream>
#include <memory>
#include <string>

struct PaymentContext {
  int bookingId{};
  double amount{};
  std::string currency{"USD"};
};

struct PaymentStrategy {
  virtual ~PaymentStrategy() = default;
  virtual bool pay(const PaymentContext& ctx) = 0;
};

struct CardPayment : PaymentStrategy {
  bool pay(const PaymentContext& ctx) override {
    std::cout << "Charging card " << ctx.amount << " " << ctx.currency
              << " for booking " << ctx.bookingId << "\n";
    return true;
  }
};

struct WalletPayment : PaymentStrategy {
  bool pay(const PaymentContext& ctx) override {
    std::cout << "Charging wallet " << ctx.amount << " for booking "
              << ctx.bookingId << "\n";
    return true;
  }
};

struct Checkout {
  std::unique_ptr<PaymentStrategy> pay_;
  explicit Checkout(std::unique_ptr<PaymentStrategy> p) : pay_(std::move(p)) {}
  bool confirm(int bookingId, double amount) {
    return pay_->pay(PaymentContext{bookingId, amount, "USD"});
  }
};
 
 

